generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Position {
  GK
  CB
  FB
  DM
  CM
  AM
  W
  ST
}

enum PlayerStatus {
  FIRST_TEAM
  RESERVE
}

enum Venue {
  HOME
  AWAY
}

enum FixtureStatus {
  SCHEDULED
  PLAYED
  POSTPONED
  CANCELLED
}

enum LineupRole {
  STARTER
  BENCH
}

enum TrainingRecurrence {
  ONE_OFF
  WEEKLY
}

enum AttendanceStatus {
  PENDING
  PRESENT
  ABSENT
}

enum NewsKind {
  CLUB_NEWS
  MATCH_REPORT
}

model AdminUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Player {
  id            String               @id @default(cuid())
  name          String
  number        Int                  @unique
  position      Position
  status        PlayerStatus         @default(FIRST_TEAM)
  active        Boolean              @default(true)
  photoUrl      String?
  bio           String?
  slots         LineupSlot[]
  showcaseSlots SquadShowcaseSlot[]
  attendance    TrainingAttendance[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model Fixture {
  id              String        @id @default(cuid())
  opponent        String
  competition     String
  round           String?
  kickoff         DateTime
  venue           Venue         @default(HOME)
  ground          String?
  formation       String        @default("4-3-3")
  lineupAnnounced Boolean       @default(false)
  status          FixtureStatus @default(SCHEDULED)
  ourScore        Int?
  theirScore      Int?
  scorers         String?
  slots           LineupSlot[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([kickoff, opponent])
}

model LineupSlot {
  id        String     @id @default(cuid())
  fixtureId String
  fixture   Fixture    @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player     @relation(fields: [playerId], references: [id])
  role      LineupRole
  slotIndex Int
  label     String

  @@unique([fixtureId, playerId])
  @@unique([fixtureId, role, slotIndex])
}

model TrainingSession {
  id         String               @id @default(cuid())
  title      String?
  location   String?
  notes      String?
  startsAt   DateTime
  recurrence TrainingRecurrence   @default(ONE_OFF)
  attendance TrainingAttendance[]
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
}

model TrainingAttendance {
  id        String           @id @default(cuid())
  sessionId String
  session   TrainingSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player           @relation(fields: [playerId], references: [id])
  status    AttendanceStatus @default(PENDING)
  markedAt  DateTime?

  @@unique([sessionId, playerId])
}

model NewsArticle {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  kind        NewsKind @default(CLUB_NEWS)
  excerpt     String
  body        String
  byline      String?
  competition String?
  ourScore    Int?
  theirScore  Int?
  startingXi  String?
  subs        String?
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Singleton: the admin-curated squad graphic shown on the homepage while the
// club is still building the squad, ahead of the real season starting in
// March. Deliberately separate from Fixture/LineupSlot — it isn't tied to an
// opponent or a real match.
model SquadShowcase {
  id        String              @id @default(cuid())
  formation String              @default("4-3-3")
  live      Boolean             @default(false)
  slots     SquadShowcaseSlot[]
  updatedAt DateTime            @updatedAt
}

model SquadShowcaseSlot {
  id         String        @id @default(cuid())
  showcaseId String
  showcase   SquadShowcase @relation(fields: [showcaseId], references: [id], onDelete: Cascade)
  playerId   String
  player     Player        @relation(fields: [playerId], references: [id])
  slotIndex  Int
  label      String

  @@unique([showcaseId, playerId])
  @@unique([showcaseId, slotIndex])
}
